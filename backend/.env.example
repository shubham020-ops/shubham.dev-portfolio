NODE_ENV=development
PORT=3001
MONGODB_URI=
JWT_SECRET=
RESEND_API_KEY=
REDIS_URL=
MONGODB_MAX_POOL_SIZE=20
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000

# Keep forwarded client IP/protocol headers untrusted unless a reverse proxy is configured.
# Use a trusted proxy address/subnet when possible; set a hop count only if the API is reachable exclusively through that exact proxy chain.
TRUST_PROXY=false

# Non-interactive admin bootstrap only; the create-admin command prompts by default.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Exact CORS allowlist, comma-separated. Development defaults to both localhost Vite ports.
# Set the actual HTTPS frontend origin(s) here when deploying; do not include paths.
CORS_ORIGINS=
# Legacy fallback still supported when CORS_ORIGINS is unset.
# FRONTEND_URL=http://localhost:5174
# Optional: CSP allowlist for a separately hosted HTTPS API.
# CSP_CONNECT_SOURCES=https://api.example.com
# Optional overrides. Defaults use the initial admin email and first verified Resend sending domain.
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
# Optional delivery-state webhook verification.
# RESEND_WEBHOOK_SECRET=
# Optional cookie overrides; production defaults to Secure and SameSite=Lax.
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
